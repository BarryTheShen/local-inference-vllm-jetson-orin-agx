index 0000000..0718899
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/w8.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: Apache-2.0
+# Kernels adapted from lulakien/inkling2-mini-3090-recipe patches/w8_gemm.py (Apache-2.0).
+"""int8 weight copies for decode-sized batches (W8A16), off by default.
+
+`VLLM_INKLING_W8` lists what gets an int8 copy: `attn` (qkvr and its row slices, wo_ud) and/or `head` (the LM head,
+shared with the DSpark drafter). The bf16 weights stay: batches over `MAX_M` rows (prompt reading) still use them, so
+prefill is unchanged; batches up to `MAX_M` rows (decode and speculative verify) read the int8 copy, half the bytes.
+Copies are made at load time (`register`), never during CUDA-graph capture; `lookup` keys on the exact view
+(data pointer, shape, row stride), so a slice must be registered as the same slice the forward pass takes.
+Quantization: symmetric per output row, scale = amax / 127, fp32 accumulation, deterministic split-K reduction."""
+
+import functools
+import os
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+W8 = frozenset(p.strip() for p in os.environ.get("VLLM_INKLING_W8", "").split(",") if p.strip())
+MAX_M = 64
+_REG: dict[tuple[int, tuple[int, ...], int], tuple[torch.Tensor, torch.Tensor]] = {}
+
+
+def _key(w: torch.Tensor) -> tuple[int, tuple[int, ...], int]:
+    return (w.data_ptr(), tuple(w.shape), w.stride(0))
+
+
+def quantize(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """bf16 [N, K] -> (int8 [N, K], fp32 scale [N]); symmetric per output row, round to nearest."""
+    q = torch.empty(w.shape, dtype=torch.int8, device=w.device)
+    s = torch.empty(w.shape[0], dtype=torch.float32, device=w.device)
+    for i in range(0, w.shape[0], 4096):  # row chunks keep temporaries small
+        wf = w[i : i + 4096].float()
+        si = (wf.abs().amax(dim=1) / 127.0).clamp_min(1e-12)
+        q[i : i + 4096] = torch.round(wf / si[:, None]).clamp_(-127, 127).to(torch.int8)
+        s[i : i + 4096] = si
+    return q, s
+
+
+# Rows below which the int8 kernel is no faster than bf16 on the Orin (launch-latency bound: the 1024-row kv slices
+# measured 51 vs 47 us at M=1), so those views keep the bf16 path.
+MIN_N = 2048
+
+
+def register(w: torch.Tensor) -> None:
+    """Make (or remake, after a reload) the int8 copy of this exact bf16 view; call after weights are loaded,
+    before graph capture. Views with fewer than MIN_N rows are skipped (bf16 is as fast)."""
+    if w.dtype == torch.bfloat16 and w.dim() == 2 and w.stride(1) == 1 and w.shape[0] >= MIN_N:
+        _REG[_key(w)] = quantize(w)
+
+
+def lookup(w: torch.Tensor, m: int) -> tuple[torch.Tensor, torch.Tensor] | None:
+    return _REG.get(_key(w)) if m <= MAX_M else None
+
+
+@triton.jit
+def _w8_kernel(x_ptr, w_ptr, s_ptr, o_ptr, p_ptr, M, N, K, sxm, swn, som,
+               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, SPLIT_K: tl.constexpr, EVEN_K: tl.constexpr):
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    rm = tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    k_per = tl.cdiv(K, SPLIT_K * BK) * BK
+    k_lo = pid_k * k_per
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    m_mask = rm[:, None] < M
+    n_mask = rn[:, None] < N
+    for k0 in range(k_lo, tl.minimum(k_lo + k_per, K), BK):
+        kk = k0 + rk
+        if EVEN_K:
+            x = tl.load(x_ptr + rm[:, None] * sxm + kk[None, :], mask=m_mask, other=0.0)
+            w = tl.load(w_ptr + rn[:, None] * swn + kk[None, :], mask=n_mask, other=0)
+        else:
+            km = kk[None, :] < K
+            x = tl.load(x_ptr + rm[:, None] * sxm + kk[None, :], mask=m_mask & km, other=0.0)
+            w = tl.load(w_ptr + rn[:, None] * swn + kk[None, :], mask=n_mask & km, other=0)
+        acc = tl.dot(x, tl.trans(w.to(tl.bfloat16)), acc)
+    acc = acc * tl.load(s_ptr + rn, mask=rn < N, other=0.0)[None, :]
+    omask = m_mask & (rn[None, :] < N)
+    if SPLIT_K == 1:
+        tl.store(o_ptr + rm[:, None] * som + rn[None, :], acc.to(o_ptr.dtype.element_ty), mask=omask)
+    else:
+        tl.store(p_ptr + (pid_k * M + rm[:, None]) * N + rn[None, :], acc, mask=omask)
+
+
+@triton.jit
+def _reduce(p_ptr, o_ptr, M, N, som, SPLIT_K: tl.constexpr, BLOCK: tl.constexpr):
+    idx = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = idx < M * N
+    acc = tl.zeros((BLOCK,), dtype=tl.float32)
+    for s in tl.static_range(SPLIT_K):  # fixed order: deterministic
+        acc += tl.load(p_ptr + s * M * N + idx, mask=mask, other=0.0)
+    tl.store(o_ptr + (idx // N) * som + idx % N, acc.to(o_ptr.dtype.element_ty), mask=mask)
+
+
+# Measured on the Jetson AGX Orin (16 SMs, 204.8 GB/s) with tests/w8_tune.py, 2026-11-23, vs bf16 F.linear:
+#   qkvr 3888x2304  M=1 65.9 us (1.72x)  M=8 67.0 us (1.71x)
+#   wo_ud 2304x3072 M=1 59.0 us (1.62x)  M=8 58.7 us (1.62x)
+#   head 201088x2304 M=1 2672 us (2.21x) M=8 2598 us (2.38x)
+# (BN, BK, SPLIT_K, warps, stages) by row-count bucket and M == 1 vs M > 1.
+_ORIN = {
+    "head": ((64, 128, 4, 2, 2), (64, 128, 1, 4, 4)),
+    "wide": ((128, 64, 1, 8, 3), (128, 128, 1, 4, 3)),
+    "mid": ((32, 64, 1, 4, 4), (64, 128, 1, 8, 3)),
+}
+
+
+@functools.cache
+def _config(M: int, N: int, K: int) -> tuple[int, int, int, int, int]:
+    bucket = "head" if N >= 65536 else "wide" if N >= 3072 else "mid"
+    bn, bk, split, warps, stages = _ORIN[bucket][0 if M == 1 else 1]
+    while K % (split * bk) and split > 1:  # keep EVEN_K-friendly splits for unusual K
+        split //= 2
+    return bn, bk, split, warps, stages
+
+
+def gemm(x: torch.Tensor, w8: tuple[torch.Tensor, torch.Tensor], out_dtype: torch.dtype | None = None,
+         out: torch.Tensor | None = None) -> torch.Tensor:
+    """`x [M, K] bf16 @ dequant(q)^T` -> [M, N], M <= MAX_M."""
+    q, s = w8
+    x = x.contiguous()
+    M, K = x.shape
+    N = q.shape[0]
+    bn, bk, split, warps, stages = _config(M, N, K)
+    if out is None:
+        out = torch.empty((M, N), dtype=out_dtype or x.dtype, device=x.device)
+    part = torch.empty((split, M, N), dtype=torch.float32, device=x.device) if split > 1 else out
+    _w8_kernel[(triton.cdiv(N, bn), split)](
+        x, q, s, out, part, M, N, K, x.stride(0), q.stride(0), out.stride(0),
+        BM=max(16, triton.next_power_of_2(M)), BN=bn, BK=bk, SPLIT_K=split, EVEN_K=K % (split * bk) == 0,
+        num_warps=warps, num_stages=stages)
+    if split > 1:
+        _reduce[(triton.cdiv(M * N, 1024),)](part, out, M, N, out.stride(0), SPLIT_K=split, BLOCK=1024, num_warps=4)
+    return out
