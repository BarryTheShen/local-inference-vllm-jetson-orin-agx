+def _device_tuning_overrides(name: str, tuning: list) -> None:
+    """Jetson patch: `VLLM_INKLING_HUMMING_TUNING=<file.json>` holding
+    `{"w13": [[lo, hi, {kernel config keys}], ...], "w2": [...]}` applies
+    those keys to the rows `(lo, hi]` of the heuristic table, splitting a
+    bucket `(a, b]` that `(lo, hi]` covers only in part (Humming launches the
+    first entry whose range holds the row count; Humming's SM87 table is the
+    SM80 one, while the Orin has 16 SMs and 204.8 GB/s)."""
+    path = os.environ.get("VLLM_INKLING_HUMMING_TUNING")
+    if not path:
+        return
+    with open(path) as f:
+        overrides = json.load(f).get(name, [])
+    for lo, hi, keys in overrides:
+        split = []
+        for a, b, config in tuning:
+            if b <= lo or hi <= a:
+                split.append([a, b, config])
+                continue
+            if a < lo:
+                split.append([a, lo, config])
+            split.append([max(a, lo), min(b, hi), {**config, **keys}])
+            if hi < b:
+                split.append([hi, b, dict(config)])
+        tuning[:] = split
+
